# One image, three modes — the complete rerun data service:
#
#   MODE=web (default)  nginx serving the wasm web viewer + /config.json   (port 80)
#   MODE=native         the Linux-native viewer on a virtual display, streamed
#                       to the browser via noVNC                               (port 8080)
#   MODE=server         the rerun catalog server (gRPC), with tos:// dataset
#                       registration and a persistent catalog                  (port 51234)
#
# The cloud runs one always-on `MODE=web` pod for everyone; users who hit the browser's
# file-size limit start their own `MODE=native` pod (bounded by platform quota, not by
# this software). Both viewers are built from the same source in the same image, so they
# can never drift apart in version.
#
# Build context must be the repo root:
#   docker compose build           (from deploy/)
# Behind a corporate TLS-intercepting proxy, run ./gen-ca-bundle.sh once before building;
# everywhere else the (gitignored) ca-bundle.pem may simply not exist — it is optional.
#
# The defaults below throttle the build to survive an 8 GB Docker Desktop VM.
# On a beefy CI machine, lift the throttles for a much faster build:
#   docker build -f deploy/Dockerfile -t rerun-viewer-unified \
#     --build-arg BUILD_GATE=no-gate \     # build wasm + native stages in parallel
#     --build-arg CARGO_JOBS= \            # empty = use all CPU cores
#     ..
#
# Building inside mainland China: point every download at a mirror
# (BASE_REGISTRY is the host prefix only, `library/` lives in the FROM lines below):
#   --build-arg BASE_REGISTRY=hub-cache-cn-beijing.cr.volces.com/
#   --build-arg APT_MIRROR=http://mirrors.volces.com   (http! see APT_MIRROR docs)
#   --build-arg RUSTUP_DIST_SERVER=https://rsproxy.cn
#   --build-arg RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup
#   --build-arg CARGO_MIRROR=sparse+https://rsproxy.cn/index/
# Deliberately NO `# syntax=` directive: that frontend image downloads from docker.io
# before any build arg exists, which cannot be mirrored and breaks CN builds.
ARG BUILD_GATE=builder-web

# Registry host prefix for base images, e.g. `hub-cache-cn-beijing.cr.volces.com/`
# (trailing slash). Empty = Docker Hub directly.
ARG BASE_REGISTRY=""

# ---------------- source stage: the repo minus deploy ----------------
# Emulates `COPY --exclude=deploy` with stable syntax only. Downstream `COPY --from`
# layers are keyed on this stage's resulting CONTENT, so edits to deploy/ configs
# still leave the cargo build layers cached (a full recompile costs ~45 min).
FROM ${BASE_REGISTRY}library/debian:trixie-slim AS src
COPY . /rerun
# The corporate-proxy CA bundle is optional (gitignored; only exists on machines behind
# a TLS-intercepting proxy). Salvage it here so later stages can COPY it without
# requiring the file to exist in the build context.
RUN cp /rerun/deploy/ca-bundle.pem /ca-bundle.pem 2>/dev/null || touch /ca-bundle.pem; \
    rm -rf /rerun/deploy

# ---------------- builder A: the wasm web viewer ----------------
# Pinned to match rust-toolchain.toml (channel = "1.95.0").
FROM ${BASE_REGISTRY}library/rust:1.95.0-slim-bookworm AS builder-web

# Debian package mirror, e.g. http://mirrors.volces.com (empty = deb.debian.org).
# Use http://, not https:// — slim base images ship without ca-certificates, so apt
# cannot verify a TLS mirror before ca-certificates gets installed (chicken-and-egg;
# package integrity is covered by apt's GPG signatures either way).
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|https://deb.debian.org|$APT_MIRROR|g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    pkg-config \
    git \
    ca-certificates \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain + crates.io mirrors (rust-toolchain pins components and the wasm target,
# so rustup downloads pieces even though the base image ships the toolchain).
ARG RUSTUP_DIST_SERVER="https://static.rust-lang.org"
ARG RUSTUP_UPDATE_ROOT="https://static.rust-lang.org/rustup"
ENV RUSTUP_DIST_SERVER=${RUSTUP_DIST_SERVER} \
    RUSTUP_UPDATE_ROOT=${RUSTUP_UPDATE_ROOT}

# Sparse crates.io mirror, e.g. sparse+https://rsproxy.cn/index/ (empty = crates.io).
ARG CARGO_MIRROR=""
RUN if [ -n "$CARGO_MIRROR" ]; then \
    printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' \
    "$CARGO_MIRROR" >> "$CARGO_HOME/config.toml"; \
    fi

# Corporate proxy CA certs (generated by gen-ca-bundle.sh; empty on machines that are
# not behind a TLS-intercepting proxy — the src stage makes the file optional).
COPY --from=src /ca-bundle.pem /tmp/corp-ca.pem
RUN cat /tmp/corp-ca.pem >> /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CARGO_HTTP_CAINFO=/etc/ssl/certs/ca-certificates.crt

# The release build hard-requires `wasm-opt` (binaryen), but it is only an optimizer:
# its input and output are the same file, so a no-op stub leaves the valid wasm-bindgen
# output in place. Cost: ~15-30% larger wasm (gzip on the wire shrinks the gap), slightly
# slower runtime. Benefit: no GitHub Releases download — binaryen is unreachable/unstable
# from CN build machines. To restore real optimization, install binaryen ≥ v117 (NOT
# Debian bookworm's v108 — it corrupts the module: `WebAssembly.Table.grow()` failure at
# startup) and drop this stub.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'echo "wasm-opt stub: skipping optimization (see Dockerfile)" >&2' \
    'exit 0' \
    > /usr/local/bin/wasm-opt && chmod +x /usr/local/bin/wasm-opt

WORKDIR /rerun
COPY --from=src /rerun .

RUN rustup target add wasm32-unknown-unknown

# Same as `pixi run rerun-build-web-release`, minus the `analytics` feature
# (internal deployment — no telemetry).
# Output: crates/viewer/re_web_viewer_server/web_viewer/
RUN cargo run -p re_dev_tools -- build-web-viewer --no-default-features --features map_view --release

# ---------------- gate stub for parallel builds ----------------
# BUILD_GATE=no-gate points builder-native's serializing COPY here instead of at
# builder-web, removing the inter-stage dependency so both cargo builds run concurrently.
FROM ${BASE_REGISTRY}library/debian:trixie-slim AS no-gate
RUN mkdir -p /rerun/crates/viewer/re_web_viewer_server/web_viewer && \
    touch /rerun/crates/viewer/re_web_viewer_server/web_viewer/index.html

# `COPY --from=` does not expand build args (FROM does), so route the choice
# through this alias stage.
FROM ${BUILD_GATE} AS build-gate

# ---------------- builder B: the Linux-native viewer ----------------
FROM ${BASE_REGISTRY}library/rust:1.95.0-slim-bookworm AS builder-native

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|https://deb.debian.org|$APT_MIRROR|g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    pkg-config \
    git \
    ca-certificates \
    curl \
    nasm \
    libudev-dev \
    && rm -rf /var/lib/apt/lists/*

ARG RUSTUP_DIST_SERVER="https://static.rust-lang.org"
ARG RUSTUP_UPDATE_ROOT="https://static.rust-lang.org/rustup"
ENV RUSTUP_DIST_SERVER=${RUSTUP_DIST_SERVER} \
    RUSTUP_UPDATE_ROOT=${RUSTUP_UPDATE_ROOT}

ARG CARGO_MIRROR=""
RUN if [ -n "$CARGO_MIRROR" ]; then \
    printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' \
    "$CARGO_MIRROR" >> "$CARGO_HOME/config.toml"; \
    fi

COPY --from=src /ca-bundle.pem /tmp/corp-ca.pem
RUN cat /tmp/corp-ca.pem >> /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CARGO_HTTP_CAINFO=/etc/ssl/certs/ca-certificates.crt

WORKDIR /rerun
COPY --from=src /rerun .

# Serialize after the wasm build: buildkit runs independent stages concurrently, and two
# parallel cargo builds OOM a small docker VM. This copy creates an artificial dependency
# on BUILD_GATE=builder-web (the default); pass BUILD_GATE=no-gate to build in parallel.
COPY --from=build-gate /rerun/crates/viewer/re_web_viewer_server/web_viewer/index.html /tmp/.build-order

# Release build:
# - oss_server = the catalog server (MODE=server), with our tos:// + persistence patches;
# - no lance/perf_telemetry;
# - LTO off + multiple codegen units + capped parallelism, because the workspace's
#   size-optimized release profile (thin LTO, codegen-units=1) OOMs an 8 GB docker VM.
#   Slightly larger binary, dramatically cheaper build; rendering speed is unaffected.
# All three are overridable build args (CARGO_JOBS empty = all cores).
ARG CARGO_JOBS=3
ARG RELEASE_LTO=off
ARG RELEASE_CGU=16
ENV CARGO_PROFILE_RELEASE_LTO=${RELEASE_LTO} \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=${RELEASE_CGU}
RUN env ${CARGO_JOBS:+CARGO_BUILD_JOBS=${CARGO_JOBS}} cargo build --package rerun-cli --release --no-default-features --features native_viewer,map_view,nasm,oss_server

# ---------------- SDK wheels: downloaded from TOS, not built here ----------------
# Every platform's wheel (Linux, macOS, Windows) is built by the GitHub Actions workflow
# (.github/workflows/build_binary_and_wheels.yml — push a `build-*` tag to trigger),
# uploaded to a TOS bucket, and only *downloaded* at image build time. nginx serves them
# at /sdk/ (see nginx.conf). Building the Linux wheel here would actually be worse: the
# Actions wheel is zig-linked against glibc 2.28 (manylinux_2_28), so it installs on far
# older distros than anything this bookworm builder could produce (glibc 2.36).
# NOTE: the wheels and this image now come from two separate builds. Build them from the
# same commit (tag the commit, wait for Actions, upload to TOS, then build the image) or
# the SDK users install can drift from the catalog server it talks to.
# The bucket URLs are deliberately NOT hardcoded — pass a comma- or space-separated
# list. Prefer commas: they survive shells without quoting AND CI systems that split
# arguments on whitespace regardless of quotes (where a quoted space-separated list
# arrives as nothing at all):
#   docker build --build-arg SDK_WHEEL_URLS=https://<bucket>…/<linux wheel>,https://<bucket>…/<mac wheel> …
#   (docker compose reads it from the SDK_WHEEL_URLS env var / .env)
# When building the SDK (BUILD_SDK_WHEEL=1, the default) SDK_WHEEL_URLS is REQUIRED and
# every URL must be reachable: an empty list, a failed download, or an under-1 MB response
# (error page / truncation) all fail the build rather than silently shipping a broken
# /sdk/. Set BUILD_SDK_WHEEL=0 to skip the SDK entirely (dev images; /sdk/ will be empty).
# This is a separate tiny stage so a wheel version bump only re-runs this download layer
# and never invalidates the ~45-minute cargo layers of the builder stages.
# ---------------- user guide: markdown -> static HTML ----------------
# The viewer's "User guide" card links to same-origin /docs/ (nginx serves it, behind the
# same Basic auth as everything else). The deployment carries its own copy because
# mainland-China networks cannot reach GitHub. cmark-gfm comes from apt (mirrorable via
# APT_MIRROR), so this adds no new network dependency.
FROM ${BASE_REGISTRY}library/debian:trixie-slim AS docs

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|https://deb.debian.org|$APT_MIRROR|g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmark-gfm \
    && rm -rf /var/lib/apt/lists/*

COPY --from=src /rerun/docs/release/user-guide /guide
# Wrap each page in a minimal self-contained HTML shell (UTF-8, readable width, styled
# tables) and rewrite the cross-links from .md to .html. Images ship as-is.
RUN mkdir -p /out && cp -R /guide/images /out/images && \
    for name in 01-viewer 02-catalog; do \
      { \
        printf '%s\n' \
          '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">' \
          '<meta name="viewport" content="width=device-width, initial-scale=1">' \
          "<title>User guide - ${name}</title>" \
          '<style>body{max-width:60em;margin:2em auto;padding:0 1em;font:16px/1.8 -apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#1a1a1a}img{max-width:100%}table{border-collapse:collapse}th,td{border:1px solid #ccc;padding:6px 10px;text-align:left}code{background:#f4f4f4;padding:1px 4px;border-radius:3px}pre{background:#f4f4f4;padding:12px;overflow-x:auto}pre code{background:none}blockquote{border-left:4px solid #ddd;margin-left:0;padding-left:1em;color:#555}</style>' \
          '</head><body>'; \
        cmark-gfm --extension table --extension strikethrough --extension autolink --unsafe "/guide/${name}.md" \
          | sed 's|href="\([0-9a-z-]*\)\.md"|href="\1.html"|g'; \
        printf '%s\n' '</body></html>'; \
      } > "/out/${name}.html"; \
    done

FROM ${BASE_REGISTRY}library/debian:trixie-slim AS sdk-wheels

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|https://deb.debian.org|$APT_MIRROR|g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=src /ca-bundle.pem /tmp/corp-ca.pem
RUN cat /tmp/corp-ca.pem >> /etc/ssl/certs/ca-certificates.crt

# The workspace version of the sources this image is built from — the downloaded wheels
# must carry the SAME version, or the SDK users install drifts from the catalog server.
COPY --from=src /rerun/Cargo.toml /tmp/workspace-Cargo.toml

ARG BUILD_SDK_WHEEL=1
ARG SDK_WHEEL_URLS=""
# Platform tags that MUST be covered for /sdk/ to count as complete. Empty = the default
# in the RUN below (linux x64 + mac arm64); pass "none" to skip the completeness check.
ARG SDK_WHEEL_REQUIRED_TAGS=""
# Every wheel is checked after download: real file (>= 1 MB, zip magic bytes — an HTML
# error page fails here), one single version across all wheels, that version equal to
# this source tree's workspace version, and all required platform tags present.
# ${url%%\?*} strips any query string (pre-signed TOS URLs) before basename, so the
# saved filename stays a valid wheel name pip can parse.
RUN mkdir -p /downloads/sdk; \
    if [ "$BUILD_SDK_WHEEL" = "1" ]; then \
      if [ -z "$SDK_WHEEL_URLS" ]; then \
        printf '%s\n' "Error: SDK_WHEEL_URLS is not set — pass --build-arg SDK_WHEEL_URLS=\"<TOS wheel URL> [<TOS wheel URL> …]\", or set BUILD_SDK_WHEEL=0 to skip the SDK." >&2; \
        exit 1; \
      fi; \
      for url in $(printf '%s' "$SDK_WHEEL_URLS" | tr ',' ' '); do \
        out="/downloads/sdk/$(basename "${url%%\?*}")"; \
        curl -fSL "$url" -o "$out" || { \
          printf '%s\n' "Error: failed to download SDK wheel." "URL: $url" >&2; exit 1; }; \
        if [ "$(wc -c < "$out")" -lt 1000000 ]; then \
          printf '%s\n' "Error: fetched wheel is under 1 MB — not a real wheel." "URL: $url" >&2; \
          exit 1; \
        fi; \
        if [ "$(head -c 2 "$out")" != "PK" ]; then \
          printf '%s\n' "Error: fetched file is not a wheel (wrong magic bytes — an error page?)." "URL: $url" >&2; \
          exit 1; \
        fi; \
      done; \
      expected="$(sed -n '/^\[workspace.package\]/,/^\[/p' /tmp/workspace-Cargo.toml | sed -n 's/^version = "\(.*\)"$/\1/p')"; \
      got="$(for f in /downloads/sdk/*.whl; do basename "$f" | cut -d- -f2; done | sort -u)"; \
      if [ "$(printf '%s\n' "$got" | wc -l)" -ne 1 ]; then \
        printf '%s\n' "Error: the downloaded wheels disagree on version: $(echo $got | tr '\n' ' ')" \
          "Upload one matching set to TOS and update SDK_WHEEL_URLS." >&2; \
        exit 1; \
      fi; \
      if [ "$got" != "$expected" ]; then \
        printf '%s\n' "Error: wheel version $got does not match this source tree ($expected)." \
          "Build the wheels from the same commit as this image (push a build-* tag on it), then update SDK_WHEEL_URLS." >&2; \
        exit 1; \
      fi; \
      required="${SDK_WHEEL_REQUIRED_TAGS:-manylinux_2_28_x86_64 macosx_11_0_arm64}"; \
      if [ "$required" != "none" ]; then \
        for tag in $required; do \
          ls /downloads/sdk/*"$tag"*.whl >/dev/null 2>&1 || { \
            printf '%s\n' "Error: no wheel for required platform tag: $tag" \
              "Present: $(ls /downloads/sdk/ | tr '\n' ' ')" \
              "Add that platform to SDK_WHEEL_URLS, or override SDK_WHEEL_REQUIRED_TAGS (\"none\" skips this check)." >&2; \
            exit 1; }; \
        done; \
      fi; \
      printf '%s\n' "SDK wheels OK: version $got, $(ls /downloads/sdk/ | wc -l) wheel(s): $(ls /downloads/sdk/ | tr '\n' ' ')"; \
    fi

# ---------------- runtime: nginx (web mode) + Xvnc/noVNC (native mode) ----------------
# trixie for its recent Mesa: bookworm's Mesa 22.3 can't software-render rerun
# (Vulkan/lavapipe presents nothing through Xvnc; GL/llvmpipe lacks R32Float rendering).
FROM ${BASE_REGISTRY}library/debian:trixie-slim

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|https://deb.debian.org|$APT_MIRROR|g" \
    /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    # web mode:
    nginx \
    # native mode — virtual X server with built-in VNC:
    tigervnc-standalone-server \
    # native mode — vncconfig, the clipboard bridge between the VNC protocol and X
    # selections; without it running, paste into the viewer never works:
    tigervnc-tools \
    # native mode — browser-facing VNC client (static files) + websocket bridge:
    novnc \
    python3-websockify \
    # native mode — no window manager runs, so the entrypoint uses xdotool to hand the
    # viewer window X input focus (without it, text fields never receive the keyboard):
    xdotool \
    # native mode — kiosk window manager: keeps the viewer window maximized to the
    # current desktop size (incl. noVNC remote-resize changes) and hands it focus.
    matchbox-window-manager \
    # native mode — H.264/H.265 playback: the native viewer decodes video by invoking
    # the FFmpeg executable (the browser viewer uses WebCodecs instead, so only the
    # native session needs this; without it every video panel shows "Couldn't find an
    # installation of the FFmpeg executable").
    ffmpeg \
    # native mode — software GPU (Vulkan via lavapipe) for wgpu:
    mesa-vulkan-drivers \
    libgl1-mesa-dri \
    libegl1 \
    libvulkan1 \
    # native mode — runtime libs the viewer window needs:
    libx11-6 \
    libx11-xcb1 \
    libxcursor1 \
    libxrandr2 \
    libxi6 \
    libxext6 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-shape0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Proxy CA for the native viewer's own TOS/HF downloads.
COPY --from=src /ca-bundle.pem /tmp/corp-ca.pem
RUN cat /tmp/corp-ca.pem >> /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Web viewer artifacts + nginx config.
COPY --from=builder-web /rerun/crates/viewer/re_web_viewer_server/web_viewer/ /usr/share/nginx/html/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# Precompress the big static assets once at build time (the wasm is tens of MiB; gzip
# cuts it to roughly a third). nginx's gzip_static serves the .gz next to the original,
# so no per-request CPU and no reliance on the gateway's compression behavior.
RUN find /usr/share/nginx/html -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.css' -o -name '*.html' \) \
    -exec gzip -9 -k {} +
RUN rm -f /etc/nginx/sites-enabled/default && mkdir -p /rrd-cache && chown www-data:www-data /rrd-cache

# Native viewer binary.
COPY --from=builder-native /rerun/target/release/rerun /usr/local/bin/rerun
# Download area served by nginx at /downloads/ (see nginx.conf): the Python SDK wheels
# (sdk/), all platforms downloaded from TOS in the sdk-wheels stage (built by GitHub
# Actions, see that stage's comment). The viewer ships inside the wheel, so there is no
# separate viewer/ download.
COPY --from=sdk-wheels /downloads/ /usr/share/nginx/downloads/
# The user guide, served at /docs/ (the viewer's "User guide" card links here).
COPY --from=docs /out /usr/share/nginx/html/docs

COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Seamless paste for the native session: Cmd+V / Ctrl+V on the noVNC page forwards the
# clipboard and pastes in one step (see the file for details). Appended into ui.js so
# it runs inside noVNC's module scope.
COPY deploy/novnc-paste-bridge.js /tmp/novnc-paste-bridge.js
RUN cat /tmp/novnc-paste-bridge.js >> /usr/share/novnc/app/ui.js && rm /tmp/novnc-paste-bridge.js

# Build provenance (pass --build-arg SCM_COMMIT_ID=$(git rev-parse HEAD) in CI).
ARG SCM_COMMIT_ID=""
LABEL org.opencontainers.image.revision="${SCM_COMMIT_ID}"

# web mode listens on 80, native mode on 8080, server mode on 51234.
EXPOSE 80 8080 51234

ENTRYPOINT ["/entrypoint.sh"]
