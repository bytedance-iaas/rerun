# Non-secret TOS settings (AK/SK live in ./secrets/, not here).
# Copy to .env and adjust.
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing
# Pre-filled dataset URL in the "Open from Volcengine TOS" dialog (optional).
TOS_DEFAULT_URL=tos://physical-ai-rerun-test/dataset-1/so101-pick-place/
# Pre-filled dataset in the "Open from Hugging Face" dialog (optional).
HF_DEFAULT_URL=henry-guo/so101-pick-place
