# Non-secret TOS settings (AK/SK live in ./secrets/, not here).
# Copy to .env and adjust.
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing

# ---- Build-time only (docker compose build) ----
# TOS URLs of the SDK wheels, comma- or space-separated (prefer commas — no shell
# quoting needed, and they survive CI runners that split on whitespace). All platforms
# are built by the GitHub Actions workflow (push a build-* tag), then uploaded to TOS;
# the image only downloads them. Required when building the SDK (BUILD_SDK_WHEEL=1);
# the build fails if unset or any URL is unreachable. Not hardcoded on purpose.
#SDK_WHEEL_URLS=https://<bucket>.tos-s3-cn-beijing.volces.com/sdk/rerun_sdk-0.36.0-cp310-abi3-manylinux_2_28_x86_64.whl,https://<bucket>.tos-s3-cn-beijing.volces.com/sdk/rerun_sdk-0.36.0-cp310-abi3-macosx_11_0_arm64.whl
# The build verifies the downloaded wheels: all one version, that version equal to the
# source tree's workspace version, and these platform tags all covered. Unset = the
# default (linux x64 + mac arm64); set to "none" to skip the platform check.
#SDK_WHEEL_REQUIRED_TAGS=manylinux_2_28_x86_64 macosx_11_0_arm64
# Where converted rrds are stored (read + write-back). Set to "off" to disable.
#TOS_RRD_ARTIFACTS_URL=tos://physical-ai-rerun-test/rrd-data/
# How many ready-made rrd artifacts to download at once when opening a dataset.
# 0 (or unset) = automatic: 3 in the browser, 4 in the native viewer. Max 16.
#RRD_ARTIFACTS_PREFETCH=0

# ---- Access control (all optional; unset = open, as before) ----
# Web viewer Basic auth: one htpasswd line, e.g. from `htpasswd -nbB alice secret`.
# (In k8s this comes from the web_htpasswd Secret key instead.)
#WEB_HTPASSWD=alice:$2y$05$...
# Native session password (noVNC prompts for it before showing the desktop).
#SESSION_PASSWORD=change-me
# Catalog server token auth: base64 secret from `rerun server generate-secret`.
# With it set, every catalog request needs a token from `rerun server generate-token`.
#RERUN_SERVER_TOKEN_SECRET=...
# Lifetime of /catalog/presign URLs in seconds (default 3600).
#RERUN_PRESIGN_EXPIRY_SECS=3600
